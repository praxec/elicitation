  "keywords": [
    "mcp",
    "model-context-protocol",
    "elicitation",
    "discovery",
    "requirements",
    "interview"
  ],
  "license": "Apache-2.0",
  "author": "Matthew Cochran <matthew@cochranweb.com>",
  "homepage": "https://github.com/praxec/elicitation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praxec/elicitation.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/praxec/elicitation/issues"
  },
  "bin": {
    "elicitation": "bin/elicitation.js"
  },
  "files": [
    "bin/elicitation.js",
    "lib/install.js",
    "lib/postinstall.js",
    "README.md",
    "LICENSE",
    "NOTICE"
